# ——— مفتاح Gemini (مطلوب) ———
# احصل عليه من https://aistudio.google.com/apikey
# لا تضع هذا الملف المعبّأ في Git. انسخه إلى .env.local
GEMINI_API_KEY=

# أسماء بديلة مقبولة للمفتاح نفسه (للتوافق مع منصات النشر):
#   GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY / GOOGLE_AI_API_KEY
# وفي الإنتاج على Cloudflare: اضبطه كـ Secret لوقت التشغيل، لا كمتغيّر Build.
# للتحقق: npm run check:gemini

# اختياري: اسم النموذج (الافتراضي gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# اختياري: ميزانية «التفكير» في نماذج 2.5 — الافتراضي 0 على نماذج flash.
# تركها فارغة أفضل؛ القيمة 0 تمنع استهلاك المخرجات في التفكير وإرجاع استجابة فارغة.
# GEMINI_THINKING_BUDGET=0

# اختياري: عنوان واجهة Gemini (نادرًا ما يُغيَّر)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ——— مصدر البحث الوحيد: تراث ———
# واجهة تراث العامة (تم التحقق منها عمليًا)
TURATH_API_BASE=https://api.turath.io
TURATH_APP_BASE=https://app.turath.io
TURATH_ENABLED=true

# ——— حدود ———
RATE_LIMIT_PER_MINUTE=10
MAX_QUESTION_CHARS=500

# ——— وضع التطوير (اختياري، لا يعمل في الإنتاج إطلاقًا) ———
# HUJJAH_DEV_FIXTURES=true
