# ——— مفتاح OpenRouter (مطلوب) ———
# احصل عليه من https://console.openrouter.com/keys
# لا تضع هذا الملف المعبّأ في Git. انسخه إلى .env.local وضع القيمة هناك.
TUA=

# وفي الإنتاج على Cloudflare: اضبطه كـ Secret لوقت التشغيل، لا كمتغيّر Build.
# للتحقق: npm run check:openrouter

# اختياري: اسم النموذج (الافتراضي openai/gpt-oss-120b)
# TUA_MODEL=openai/gpt-oss-120b

# اختياري: جهد «التفكير» على النماذج الاستدلالية (low/medium/high/none).
# الافتراضي low — يمنع استهلاك حدّ المخرجات في التفكير وإرجاع استجابة فارغة.
# TUA_REASONING_EFFORT=low

# اختياري: عنوان واجهة OpenRouter (نادرًا ما يُغيَّر)
# TUA_BASE_URL=https://openrouter.ai/api/v1

# ——— مصدر البحث الوحيد: تراث ———
# واجهة تراث العامة (تم التحقق منها عمليًا)
TURATH_API_BASE=https://api.turath.io
TURATH_APP_BASE=https://app.turath.io
TURATH_ENABLED=true

# ——— حدود ———
RATE_LIMIT_PER_MINUTE=10
MAX_QUESTION_CHARS=500

# ——— وضع التطوير (اختياري، لا يعمل في الإنتاج إطلاقًا) ———
# HUJJAH_DEV_FIXTURES=true
