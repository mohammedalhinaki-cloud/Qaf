# ——— مفتاح Gemini (مطلوب) ———
# احصل عليه من https://aistudio.google.com/apikey
# لا تضع هذا الملف المعبّأ في Git. انسخه إلى .env.local
GEMINI_API_KEY=

# اختياري: اسم النموذج (الافتراضي gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ——— المصادر ———
# واجهة تراث العامة (تم التحقق منها عمليًا)
TURATH_API_BASE=https://api.turath.io
TURATH_APP_BASE=https://app.turath.io
TURATH_ENABLED=true

# خدمة الشاملة الرسمية MCP (قراءة فقط، بلا حساب)
# المصدر: https://shamela.ws/page/support
SHAMELA_MCP_URL=https://shamela.ws/mcp
SHAMELA_WEB_BASE=https://shamela.ws
SHAMELA_ENABLED=true

# ——— حدود ———
RATE_LIMIT_PER_MINUTE=10
MAX_QUESTION_CHARS=500
